# PostgreSQL connection string
DATABASE_URL=postgresql://scraper:scraper@localhost:5432/scraper

# Local attachment storage
ATTACHMENTS_DIR=./data/attachments

# Runtime safety defaults
SCRAPER_TRANSPORT=auto
SCRAPER_CONCURRENCY=5
SCRAPER_MIN_DELAY=1.5
SCRAPER_JITTER=0.75
SCRAPER_TIMEOUT=30
MAX_ATTACHMENT_BYTES=26214400
SCRAPER_USER_AGENT=LunaResearchScraper/0.1 (+respectful async crawler)

# Replace these URLs with a permitted mirror or fixture when needed
ZAKUPKI_LIST_URL=https://zakupki.gov.ru/epz/order/extendedsearch/results.html
ZAKUPKI_MAX_PAGES=100
FOURGLAZA_LIST_URL=https://4glaza.ru/katalog/teleskopy/
